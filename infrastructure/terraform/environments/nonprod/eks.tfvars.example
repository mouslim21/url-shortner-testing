aws_account_id = "123456789012" # Replace with the account verified by STS.
eks_admin_principal_arn = "arn:aws:iam::123456789012:user/REPLACE_WITH_YOUR_PROVISIONER"
eks_kubernetes_version = "1.35"

# Private-only API by default. Local kubectl needs VPC connectivity in this mode.
eks_public_endpoint_enabled = false
eks_trusted_public_cidrs    = []

# For public administration, enable the endpoint and configure IPv4 CIDRs.
# Use ["0.0.0.0/0"] only when all-IPv4 access is explicitly intended.
